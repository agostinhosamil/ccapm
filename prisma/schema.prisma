generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  disabled = env("DISABLE_ERD_GENERATOR")
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  description String   @db.VarChar(255)
  date        DateTime @db.DateTime(0)
  doctor      Int?     @db.UnsignedInt
  owner_type  String   @db.VarChar(255)
  owner_id    Int      @db.UnsignedInt
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @db.Timestamp(0)
  token       String?  @default(cuid()) @db.VarChar(255)
  users       User?    @relation(fields: [doctor], references: [id], map: "appointments_doctor_foreign")

  @@index([doctor], map: "appointments_doctor_foreign")
  @@map("appointments")
}

model Email {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  value      String   @unique(map: "emails_value_unique") @db.VarChar(255)
  owner_type String   @db.VarChar(255)
  owner_id   Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@map("emails")
}

model History {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  action     String   @default("CREATED") @db.VarChar(255)
  resource   String   @db.VarChar(255)
  user_id    Int?     @db.UnsignedInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  users      User?    @relation(fields: [user_id], references: [id], map: "histories_user_id_foreign")

  @@index([user_id], map: "histories_user_id_foreign")
  @@map("histories")
}

model Language {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(255)
  key        String   @unique(map: "languages_key_unique") @db.VarChar(12)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@map("languages")
}

model PermissionRole {
  id            Int        @id @default(autoincrement()) @db.UnsignedInt
  role_id       Int        @db.UnsignedInt
  permission_id Int        @db.UnsignedInt
  created_at    DateTime   @default(now()) @db.Timestamp(0)
  updated_at    DateTime   @default(now()) @db.Timestamp(0)
  permissions   Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, map: "permission_role_permission_id_foreign")
  roles         Role       @relation(fields: [role_id], references: [id], onDelete: Cascade, map: "permission_role_role_id_foreign")

  @@index([permission_id], map: "permission_role_permission_id_foreign")
  @@index([role_id], map: "permission_role_role_id_foreign")
  @@map("permission_role")
}

model Permission {
  id              Int              @id @default(autoincrement()) @db.UnsignedInt
  name            String           @unique(map: "permissions_name_unique") @db.VarChar(255)
  description     String           @db.VarChar(255)
  key             String           @unique(map: "permissions_key_unique") @db.VarChar(255)
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime         @default(now()) @db.Timestamp(0)
  permission_role PermissionRole[]

  @@map("permissions")
}

model phinxlog {
  version        BigInt    @id
  migration_name String?   @db.VarChar(100)
  start_time     DateTime? @db.Timestamp(0)
  end_time       DateTime? @db.Timestamp(0)
  breakpoint     Boolean   @default(false)

  @@map("phinxlog")
}

model Phone {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  value      String   @unique(map: "phones_value_unique") @db.VarChar(255)
  owner_type String   @db.VarChar(255)
  owner_id   Int      @db.UnsignedInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@map("phones")
}

model Role {
  id              Int              @id @default(autoincrement()) @db.UnsignedInt
  name            String           @unique(map: "roles_name_unique") @db.VarChar(255)
  description     String           @db.VarChar(255)
  key             String           @unique(map: "roles_key_unique") @db.VarChar(255)
  created_at      DateTime         @default(now()) @db.Timestamp(0)
  updated_at      DateTime         @default(now()) @db.Timestamp(0)
  permission_role PermissionRole[]
  users           User[]

  @@map("roles")
}

model Setting {
  id           Int          @id @default(autoincrement()) @db.UnsignedInt
  property     String       @db.VarChar(255)
  value        String       @db.VarChar(255)
  type         SettingsType @default(string)
  context_type String       @default("user") @db.VarChar(255)
  context_id   Int          @db.UnsignedInt
  created_at   DateTime     @default(now()) @db.Timestamp(0)
  updated_at   DateTime     @default(now()) @db.Timestamp(0)

  @@map("settings")
}

model Token {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  owner_type String   @db.VarChar(255)
  owner_id   Int?     @db.UnsignedInt
  content    String   @unique(map: "tokens_content_unique") @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  @@map("tokens")
}

model User {
  id           Int           @id @default(autoincrement()) @db.UnsignedInt
  key          String        @unique(map: "users_key_unique") @db.VarChar(255)
  name         String        @db.VarChar(255)
  email        String        @unique(map: "users_email_unique") @db.VarChar(255)
  phone        String?       @unique(map: "users_phone_unique") @db.VarChar(255)
  username     String        @unique(map: "users_username_unique") @db.VarChar(255)
  photo        String?       @default("user-avatar-placeholder.jpg") @db.VarChar(255)
  password     String        @db.VarChar(255)
  role_id      Int?          @db.UnsignedInt
  created_at   DateTime      @default(now()) @db.Timestamp(0)
  updated_at   DateTime      @default(now()) @db.Timestamp(0)
  appointments Appointment[]
  histories    History[]
  roles        Role?         @relation(fields: [role_id], references: [id], map: "users_role_id_foreign")

  @@index([role_id], map: "users_role_id_foreign")
  @@map("users")
}

enum SettingsType {
  string
  number
  boolean
  object
  array
}
